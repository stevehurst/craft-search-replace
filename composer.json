{
  "name": "foundbrand/craft-search-replace",
  "description": "Find text in any field across all elements, then replace it and resave through Craft.",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": ["craft", "cms", "craftcms", "craft-plugin", "find", "replace", "resave"],
  "authors": [
    {
      "name": "Found Brand Agency",
      "homepage": "https://foundbrand.agency"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "foundbrand\\searchreplace\\": "src/"
    }
  },
  "extra": {
    "name": "Search and Replace",
    "handle": "search-replace",
    "developer": "Found Brand Agency",
    "developerUrl": "https://foundbrand.agency",
    "documentationUrl": "https://github.com/stevehurst/craft-search-replace/blob/main/README.md",
    "class": "foundbrand\\searchreplace\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  }
}
